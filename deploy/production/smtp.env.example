# SMTP settings shared by the production backend and one-off setup services.
# Copy to /etc/hams/smtp.env (or HAMS_CONFIG_DIR/smtp.env).
# Keep the completed file outside Git/source, restrict it to the deployment
# operator (mode 0600), and include it in protected configuration backups.
# Compose uses format: raw: literal KEY=value, no surrounding quotes or
# ${OTHER_VARIABLE} references. This file must contain SMTP settings only.

# Active preset: Gmail on port 587 with required STARTTLS.
# SMTP_SECURE=false starts a normal SMTP connection; SMTP_REQUIRE_TLS=true
# requires upgrading it to TLS before sending. Certificate verification stays on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Fill all three values before deployment:
# SMTP_USER: full Gmail/Google Workspace address of the sending account.
# SMTP_PASS: its 16-character Google App Password without grouping spaces,
# not the ordinary Google password. The account must allow App Passwords.
# SMTP_FROM: HAMS <the-same-address-as-SMTP_USER> unless an allowed alias exists.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Use a dedicated account with 2-Step Verification and App Passwords enabled.
# Enter the 16-character App Password without display-grouping spaces, not
# the normal Google account password. Some accounts do not allow App Passwords.
# Use that account as the sender unless a permitted sender alias is configured.

# Brevo alternative: set SMTP_HOST=smtp-relay.brevo.com and use the exact Brevo
# SMTP login/key and approved sender. Do not add duplicate keys.

# If required by the selected provider, implicit TLS on port 465 uses
# SMTP_PORT=465 and SMTP_SECURE=true; keep SMTP_REQUIRE_TLS=true.
# Brevo also supports port 2525 with SMTP_SECURE=false/SMTP_REQUIRE_TLS=true
# when the server network cannot reach 587. Confirm the chosen port works.
# These are OUTBOUND SMTP ports, unrelated to the website's 20443/443 mapping.
# Plain HTTP for the website does not disable SMTP STARTTLS or CA verification.

# Provider changes require recreating the backend container to load this file;
# a container restart alone does not reload environment variables. No image
# rebuild or database migration is needed for SMTP-only changes. The setup
# service loads the same settings on its next explicit invocation.

# Provider documentation:
# https://help.brevo.com/hc/en-us/articles/7924908994450
# https://help.brevo.com/hc/en-us/articles/10905415650322
# https://support.google.com/accounts/answer/185833
