# Production backend settings shared by the backend and one-off setup services.
# Copy to /etc/hams/backend.env (or HAMS_CONFIG_DIR/backend.env).
# The real file contains credentials: keep it outside Git/source, restrict it
# to the deployment operator (mode 0600), and include it in protected backups.
#
# Compose loads this file with format: raw. Use literal KEY=value lines without
# surrounding quotes, shell substitutions, or ${OTHER_VARIABLE} references.
# Fill the empty values on the server; never commit the completed file.
# This template alone is not a runnable application configuration.

# Database service/user/database names match deploy/production/compose.yaml.
# Required URL format:
# postgresql://hams_prod:URL_ENCODED_PASSWORD@postgres:5432/hams_prod?schema=public
# Use the SAME password as HAMS_CONFIG_DIR/postgres-password. Percent-encode
# the password in the URL if it contains reserved characters. A freshly
# generated random hexadecimal password avoids that encoding requirement.
# Use the Docker service name postgres, not localhost or the VM lab database.
DATABASE_URL=
DATABASE_POOL_MAX=20

# Generate two INDEPENDENT random values for the new production installation.
# BETTER_AUTH_SECRET: at least 32 characters (32 random bytes as hex is suitable).
# TWO_FACTOR_ENCRYPTION_KEY: exactly 64 hexadecimal characters (32 random bytes).
# Keep both values unchanged across routine image updates and restores.
# Replacing the 2FA key prevents decrypting existing authenticator secrets.
# Do not reuse the development/VM lab keys.
BETTER_AUTH_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=

# Two distinct real ADMIN owners are required for bootstrap and handover.
# Fill both people's email, username, first name and last name. Their email
# addresses must differ; their usernames must also differ ignoring case.
# Limits: email 100 characters, username 50, first name 100, last name 100.
# Employee IDs and initial passwords are generated by the bootstrap command.
# Do not add a password/TOTP secret here. Each owner enrolls 2FA themselves.
# Keep these identities configured for the handover checks after bootstrap.
BOOTSTRAP_ADMIN_1_EMAIL=
BOOTSTRAP_ADMIN_1_USERNAME=
BOOTSTRAP_ADMIN_1_FIRSTNAME=
BOOTSTRAP_ADMIN_1_LASTNAME=

BOOTSTRAP_ADMIN_2_EMAIL=
BOOTSTRAP_ADMIN_2_USERNAME=
BOOTSTRAP_ADMIN_2_FIRSTNAME=
BOOTSTRAP_ADMIN_2_LASTNAME=

# Authoritative non-secret settings are supplied by compose.yaml:
# production runtime and installation mode, port 3000, local image volume paths, disabled Gemini,
# HAMS_ALLOW_INSECURE_HTTP=true and BOTH URLs http://med.hss05.com:20443.
# HTTP opt-in is limited to the customer installation mode; NODE_ENV stays production.
# Do not replace that public origin with server port 443 or container port 8081.
# SMTP settings belong in the separate smtp.env, not this file. Backend and
# setup both load it; bootstrap uses it to send real credentials/verification.
