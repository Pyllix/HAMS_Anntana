# Non-secret Docker Compose settings for the production installation.
# Copy this template to /etc/hams/compose.env on the server.
# Fill the two empty values before building or starting services.
#
# Run from the repository root with Docker Compose >= 2.30:
#   docker compose --env-file /etc/hams/compose.env \
#     -f deploy/production/compose.yaml ...
#
# Public URL is fixed in compose.yaml and nginx.conf:
#   https://med.hss05.com:20443
# Server listener is HAMS_BIND_IP:443; the frontend container uses 8443.
# External 20443 -> server 443 forwarding must be configured by IT.
# Changing an IP below does not update public DNS or configure port forwarding.

# Release commit used to tag all three HAMS images consistently.
# After committing the complete deployment files and checking out that release,
# obtain the value with: git rev-parse --short=12 HEAD
# This value labels images; it does not check out code or perform an update.
# Use the same value for build, migration, startup and backup of that release.
HAMS_RELEASE=

# Absolute Linux directory on the Docker host, outside the source checkout.
# Contains compose.env, backend.env, smtp.env, postgres-password and tls/.
# Set a real directory path without a trailing slash.
HAMS_CONFIG_DIR=/etc/hams

# Local IPv4 address assigned to the server's network interface.
# Obtain the addresses with: ip -4 -brief address show scope global
# Choose the address reached by the upstream NAT/proxy; not the public DNS
# name, the upstream public IP, or a Docker bridge/container address.
# Leave blank until that address is confirmed; Compose then refuses to start.
HAMS_BIND_IP=

# Database URL, auth/encryption keys and real ADMIN details belong in
# backend.env. SMTP host/port/TLS/from/login/key belong in smtp.env.
# Neither those secrets nor the TLS private key belong in this template.
