# HAMS: ค่าตั้งต้นสำหรับติดตั้งระบบจริงของโรงพยาบาล
# ลูกค้า/IT กรอกข้อมูลในส่วนที่ระบุ; ทีมติดตั้งเป็นผู้สร้าง secret/key
# ไฟล์นี้เป็นตัวอย่าง ไม่มีรหัสผ่านจริง และยังใช้เปิดระบบไม่ได้จนกว่าจะกรอกครบ
# ทีมติดตั้งนำค่าที่ตรวจแล้วไปใส่ใน environment ของ server หรือไฟล์ .env
#
# ขอบเขต: Backend, PostgreSQL, Authentication, SMTP และ ADMIN เริ่มต้น
# การตั้งค่ารูปภาพยังต้องทำตามขอบเขตงาน storage migration; Gemini ปิดเป็นค่าเริ่มต้น

# 1. การรันระบบ — ทีมติดตั้งกำหนด
NODE_ENV=production
PORT=3000

# 2. PostgreSQL — IT จัดฐานข้อมูลและบัญชีเชื่อมต่อ
# รูปแบบ: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
# หาก username/password มีอักขระพิเศษ ให้ URL-encode ก่อนใส่ใน URL
# ใช้ฐาน production ที่แยกจาก demo; ตั้งค่า TLS ตามฐานที่ IT จัดให้
DATABASE_URL=""

# 3. URL สาธารณะของระบบ — IT แจ้งโดเมน; ทีมติดตั้งกำหนด path ให้ตรง proxy
# BETTER_AUTH_URL: Base URL ที่ระบบ Authentication ใช้สร้างลิงก์ ต้องเป็น HTTPS
# FRONTEND_URL: URL หน้าเว็บที่เจ้าหน้าที่เปิด ต้องเป็น HTTPS
BETTER_AUTH_URL=""
FRONTEND_URL=""

# 4. Secret/key — ทีมติดตั้งสร้างแบบสุ่ม แยกจากระบบ demo
# BETTER_AUTH_SECRET: อย่างน้อย 32 ตัวอักษร
# TWO_FACTOR_ENCRYPTION_KEY: สุ่ม 32 bytes แล้วเขียนเป็น hexadecimal 64 ตัว
# เก็บ key สำหรับกู้คืนอย่างปลอดภัย และไม่สุ่มเปลี่ยนใหม่ทุกครั้งที่ deploy
BETTER_AUTH_SECRET=""
TWO_FACTOR_ENCRYPTION_KEY=""

# 5. SMTP ของโรงพยาบาล — ขอข้อมูลและสิทธิ์ส่งจาก IT
# ค่าด้านล่างเป็นตัวอย่างสำหรับ port 587 + STARTTLS; ใช้ค่าที่ IT ยืนยัน
# หากใช้ port 465 + TLS ตั้ง SMTP_SECURE=true และ SMTP_REQUIRE_TLS=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# SMTP_USER/PASS เว้นว่างได้เมื่อ IT อนุญาตส่งโดยตรวจ IP แทนการล็อกอิน
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM: อีเมลผู้ส่งที่ IT อนุญาต เช่น HAMS <noreply@example.invalid>
SMTP_FROM=""

# 6. ผู้ดูแลระบบจริง 2 คน — ลูกค้าระบุเจ้าของบัญชี
# ไม่จำเป็นต้องใช้อีเมลชื่อ admin; ต้องเป็นกล่องที่เจ้าของรับและยืนยันอีเมลได้
# EMAIL, USERNAME และ EMPLOYEE_ID ของสองคนต้องไม่ซ้ำกัน
# EMPLOYEE_ID: รหัสที่ตกลงใช้ใน HAMS ตามข้อมูลบุคลากรที่ตรวจรับแล้ว
# หากลูกค้ายังไม่ส่งข้อมูล ให้เว้นว่างและยังไม่รัน prisma:bootstrap-admins
# รหัสผ่านเริ่มต้นสุ่มโดย bootstrap script ไม่ต้องมีตัวแปรรหัสผ่าน ADMIN
BOOTSTRAP_ADMIN_1_EMAIL=""
BOOTSTRAP_ADMIN_1_USERNAME=""
BOOTSTRAP_ADMIN_1_FIRSTNAME=""
BOOTSTRAP_ADMIN_1_LASTNAME=""
BOOTSTRAP_ADMIN_1_EMPLOYEE_ID=""

BOOTSTRAP_ADMIN_2_EMAIL=""
BOOTSTRAP_ADMIN_2_USERNAME=""
BOOTSTRAP_ADMIN_2_FIRSTNAME=""
BOOTSTRAP_ADMIN_2_LASTNAME=""
BOOTSTRAP_ADMIN_2_EMPLOYEE_ID=""

# 7. Gemini Forecast — customer mode disables external forecasting by default
HAMS_INSTALLATION_MODE="customer"
GEMINI_ENABLED="false"
# Only add an approved key after explicit customer authorization and set GEMINI_ENABLED=true.
GEMINI_API_KEY=""
GEMINI_MODEL=""
GEMINI_TIMEOUT_MS=30000
