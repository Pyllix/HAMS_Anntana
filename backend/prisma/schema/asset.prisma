model Asset {
  id                   String     @id @default(uuid()) @map("asset_id")
  noid                 String?    @map("noid") @db.VarChar(30)
  name                 String     @map("name") @db.VarChar(100)
  model                String     @map("model") @db.VarChar(100)
  serialNo             String?    @map("serial_no") @db.VarChar(30)
  budgetType           String     @default("") @map("budget_type") @db.VarChar(100)
  acqType              String     @default("") @map("acq_type") @db.VarChar(100)
  price                Decimal    @map("price") @db.Decimal(15, 2)
  acqDoc               String     @default("") @map("acq_doc") @db.Text
  warrantyDate         String?    @map("warranty_date") @db.VarChar(30)
  pmType               PmType     @default(IM) @map("pm_type")
  pmIntervalMonth      Int?       @map("pm_interval_month")
  calType              CalType    @default(IC) @map("cal_type")
  calIntervalMonth     Int?       @map("cal_interval_month")
  equipment_type_id    Int?       @map("equipment_type")
  riskLevel            RiskLevel  @default(UNSPECIFIED) @map("risk_level")
  isSpecial            Boolean    @default(false) @map("is_special")
  isBackup             Boolean    @default(false) @map("is_backup")
  remark               String?    @db.Text
  imageUrl             String     @default("") @map("image_url") @db.Text
  receivedDate         DateTime   @map("receive_date")

  //relations (FK scalars)
  type_id                Int     @map("type_id")
  section_id             String  @map("section_id")
  company_id             String  @map("company_id")
  asset_status_id        Int     @map("asset_status_id")
  availability_status_id Int?    @map("availability_status_id")
  owner_id               String  @map("owner_id")
  createdBy              String  @map("created_by")
  updatedBy              String  @map("updated_by")

  //relation objects (Many-to-One)
  type               AssetType           @relation(fields: [type_id], references: [id])
  section            Section             @relation(fields: [section_id], references: [id])
  company            Company             @relation(fields: [company_id], references: [id])
  status             AssetStatus         @relation(fields: [asset_status_id], references: [id])
  availabilityStatus AvailabilityStatus? @relation(fields: [availability_status_id], references: [id])
  equipmentType      EquipmentType?      @relation(fields: [equipment_type_id], references: [id])
  owner              User                @relation("AssetOwner", fields: [owner_id], references: [id])
  creator            User                @relation("CreatedBy", fields: [createdBy], references: [id])
  updater            User                @relation("UpdatedBy", fields: [updatedBy], references: [id])

  // One-to-Many relations
  disposals          Disposal[]
  transfers          Transfer[]
  borrowTransactions BorrowTransaction[]
  repairJobs         RepairJob[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section_id])
  @@index([asset_status_id])
  @@index([availability_status_id])
  @@index([type_id])
  @@index([createdAt])
  @@index([noid])
  @@map("asset")
}
