// Transfer model (การโอนย้ายครุภัณฑ์)

model Transfer {
  id              String    @id @default(uuid()) @map("id")
  asset_id        String    @map("asset_id")
  transferDocNo   String    @map("transfer_doc_no") @db.VarChar(255)
  transferDate    DateTime  @map("transfer_date")
  from_section_id String?   @map("from_section_id")
  to_section_id   String?   @map("to_section_id")
  fromLocation    String?   @map("from_location") @db.VarChar(255)
  toLocation      String?   @map("to_location") @db.VarChar(255)
  transferred_by  String    @map("transferred_by")
  remark          String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  asset         Asset    @relation(fields: [asset_id], references: [id])
  fromSection   Section? @relation("TransferFromSection", fields: [from_section_id], references: [id])
  toSection     Section? @relation("TransferToSection", fields: [to_section_id], references: [id])
  transferredBy User     @relation("TransferTransferredBy", fields: [transferred_by], references: [id])

  @@map("transfer")
}

