model BorrowStatus {
  id        Int       @id @default(autoincrement()) @map("borrow_status_id")
  code      String    @unique @default("") @map("status_code") @db.VarChar(20)
  name      String    @default("") @map("status_name") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  transactions BorrowTransaction[]

  @@map("borrow_status")
}

model BorrowTransaction {
  id                   String  @id @default(uuid()) @map("borrow_transaction_id")
  borrowNo             String  @unique @map("borrow_no") @db.VarChar(50)
  asset_id             String  @map("asset_id")
  borrower_id          String  @map("borrower_id")
  created_by_user_id   String? @map("created_by_user_id")
  approved_by_user_id  String? @map("approved_by_user_id")
  handover_by_user_id  String? @map("handover_by_user_id")
  returned_by_user_id  String? @map("returned_by_user_id")
  received_by_user_id  String? @map("received_by_user_id")
  rejected_by_user_id  String? @map("rejected_by_user_id")
  cancelled_by_user_id String? @map("cancelled_by_user_id")
  borrow_status_id     Int     @map("borrow_status_id")

  approved_at      DateTime?        @map("approved_at")
  handover_date    DateTime?        @map("handover_date")
  return_date      DateTime?        @map("return_date")
  cancelled_at     DateTime?        @map("cancelled_at")
  rejected_at      DateTime?        @map("rejected_at")
  cancel_reason    String?          @map("cancel_reason") @db.Text
  return_condition ReturnCondition? @map("return_condition")
  return_method    ReturnMethod?    @map("return_method")
  return_remark    String?          @map("return_remark") @db.Text
  reject_remark    String?          @map("reject_remark") @db.Text

  request_source  RequestSource  @default(SELF_SERVICE) @map("request_source")
  delivery_method DeliveryMethod @default(PICKUP) @map("delivery_method")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  asset           Asset        @relation(fields: [asset_id], references: [id])
  borrower        User         @relation("BorrowerUser", fields: [borrower_id], references: [id])
  createdByUser   User?        @relation("BorrowCreatedBy", fields: [created_by_user_id], references: [id])
  approvedByUser  User?        @relation("BorrowApprovedBy", fields: [approved_by_user_id], references: [id])
  handoverByUser  User?        @relation("BorrowHandoverBy", fields: [handover_by_user_id], references: [id])
  returnedByUser  User?        @relation("ReturnedByUser", fields: [returned_by_user_id], references: [id])
  receivedByUser  User?        @relation("ReceivedByUser", fields: [received_by_user_id], references: [id])
  rejectedByUser  User?        @relation("BorrowRejectedBy", fields: [rejected_by_user_id], references: [id])
  cancelledByUser User?        @relation("BorrowCancelledBy", fields: [cancelled_by_user_id], references: [id])
  borrowStatus    BorrowStatus @relation(fields: [borrow_status_id], references: [id])

  @@map("borrow_transaction")
}
