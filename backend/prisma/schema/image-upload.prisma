model ImageUpload {
  id                   String             @id @default(uuid()) @db.Uuid
  uploaderId           String             @map("uploader_id")
  purpose              ImageUploadPurpose
  targetId             String?            @map("target_id")
  creationContextHash  String?            @map("creation_context_hash") @db.Char(64)
  storageProvider      String             @default("cloudinary") @map("storage_provider") @db.VarChar(40)
  storageAccountId     String             @map("cloud_name") @db.VarChar(128)
  publicId             String             @unique @map("public_id") @db.VarChar(255)
  resourceType         String             @default("image") @map("resource_type") @db.VarChar(20)
  deliveryType         String             @map("delivery_type") @db.VarChar(20)
  policyRevision       String             @map("policy_revision") @db.VarChar(80)
  sourceContentType    String             @map("source_content_type") @db.VarChar(80)
  declaredSizeBytes    Int                @map("declared_size_bytes")
  verificationAttempts Int                @default(0) @map("verification_attempts")
  status               ImageUploadStatus  @default(AUTHORIZED)
  issuedAt             DateTime           @map("issued_at")
  signatureExpiresAt   DateTime           @map("signature_expires_at")
  intentExpiresAt      DateTime           @map("intent_expires_at")
  reconciliationAfter  DateTime           @map("reconciliation_after")
  providerCreatedAt    DateTime?          @map("provider_created_at")
  attachmentExpiresAt  DateTime?          @map("attachment_expires_at")
  verifiedVersion      Int?               @map("verified_version")
  verifiedFormat       String?            @map("verified_format") @db.VarChar(20)
  verifiedBytes        Int?               @map("verified_bytes")
  verifiedWidth        Int?               @map("verified_width")
  verifiedHeight       Int?               @map("verified_height")
  verifiedPages        Int?               @map("verified_pages")
  verifiedEvidenceHash String?            @map("verified_evidence_hash") @db.Char(64)
  claimedTargetId      String?            @map("claimed_target_id")
  claimedAt            DateTime?          @map("claimed_at")
  claimFingerprint     String?            @map("claim_fingerprint") @db.Char(64)
  rejectionCode        String?            @map("rejection_code") @db.VarChar(80)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([uploaderId, purpose, createdAt])
  @@index([storageProvider, storageAccountId, createdAt])
  @@index([status, signatureExpiresAt])
  @@index([status, intentExpiresAt])
  @@index([status, attachmentExpiresAt])
  @@map("image_upload")
}
