// This file defines the User model and related models for authentication in the Prisma schema.

model User {
  id            String    @id
  employeeId    String?   @unique @map("employee_id") @db.VarChar(50)
  userName      String    @default("") @map("user_name") @db.VarChar(50)
  firstname     String    @default("") @map("first_name") @db.VarChar(100)
  lastname      String    @default("") @map("last_name") @db.VarChar(100)
  email         String    @unique @db.VarChar(100)
  emailVerified Boolean
  imageUrl      String?
  section_id    String?   @map("section_id")
  role          UserRole  @default(DEPARTMENT_STAFF)
  createdAt     DateTime
  updatedAt     DateTime
  deletedAt     DateTime? @map("deleted_at")

  //Auth relations
  sessions      Session[]
  accounts      Account[]
  section       Section?  @relation(fields: [section_id], references: [id])
  createdAssets Asset[]   @relation("CreatedBy")
  updatedAssets Asset[]   @relation("UpdatedBy")
  ownedAssets   Asset[]   @relation("AssetOwner")

  //Transfer relations
  requestedTransfers Transfer[] @relation("TransferRequestedBy")
  approvedTransfers  Transfer[] @relation("TransferApprovedBy")
  receivedTransfers  Transfer[] @relation("TransferReceivedBy")

  //Borrow relations
  borrowedTransactions        BorrowTransaction[] @relation("BorrowerUser")
  createdBorrowTransactions   BorrowTransaction[] @relation("BorrowCreatedBy")
  approvedBorrowTransactions  BorrowTransaction[] @relation("BorrowApprovedBy")
  handoverBorrowTransactions  BorrowTransaction[] @relation("BorrowHandoverBy")
  returnedTransactions        BorrowTransaction[] @relation("ReturnedByUser")
  receivedTransactions        BorrowTransaction[] @relation("ReceivedByUser")
  rejectedBorrowTransactions  BorrowTransaction[] @relation("BorrowRejectedBy")
  cancelledBorrowTransactions BorrowTransaction[] @relation("BorrowCancelledBy")

  //Spare parts relations
  sparepartAdds               SparepartAdd[]
  sparepartTxns               SparepartTxn[]

  //Repair relations
  reportedRepairs             RepairJob[]      @relation("RepairReporter")
  receivedRepairs             RepairJob[]      @relation("RepairReceiver")
  createdRepairs              RepairJob[]      @relation("RepairCreatedBy")
  updatedRepairs              RepairJob[]      @relation("RepairUpdatedBy")
  mechanicRepairs             MechanicRepair[]
  completedRepairSteps        RepairJobStep[]

  @@index([section_id])
  @@index([role])
  @@map("users")
}

// This model is used for managing user sessions, including session tokens and expiration times.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// This model is used for third-party authentication providers (e.g., Google, Facebook) and also for email/password authentication.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("accounts")
}

// This model is used for email verification and password reset tokens.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
}
