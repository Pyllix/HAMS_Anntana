DATABASE_URL="postgresql://postgres:password@localhost:5432/db_name?schema=public"
BETTER_AUTH_SECRET="your_better_auth_secret"
BETTER_AUTH_URL="http://localhost:3000"

# Generate a private 32-byte hex key for encrypting 2FA secrets and pre-auth sessions
TWO_FACTOR_ENCRYPTION_KEY=""

FRONTEND_URL="http://localhost:5173"
# Optional on an isolated test backend: allow all Preview URLs for one Vercel project/team.
# Replace the project and team names with those from your Vercel Preview URL.
VERCEL_PREVIEW_ORIGIN_PATTERN=""

# Cloudinary image storage (required when using image upload routes)
# Backend only. Never expose the API secret in frontend code or commit real credentials.
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
IMAGE_UPLOAD_MAX_SOURCE_BYTES=10000000
IMAGE_UPLOAD_MAX_SOURCE_PIXELS=25000000
IMAGE_UPLOAD_MAX_INTENTS_PER_ACTOR_PER_HOUR=20
IMAGE_UPLOAD_MAX_INTENTS_PER_CLOUD_PER_HOUR=300
IMAGE_UPLOAD_MAX_COMPLETION_ATTEMPTS_PER_INTENT=10
IMAGE_UPLOAD_SIGNATURE_WINDOW_SECONDS=3600
IMAGE_UPLOAD_ATTACHMENT_WINDOW_SECONDS=3600
# Keep disabled until Ticket 05 approves the shared CRUD caller cutover.
IMAGE_CRUD_ATTACHMENT_ENABLED=false
# Optional real-provider contract tests use a separate test-only Cloudinary account
# and synthetic files; they are skipped unless RUN_CLOUDINARY_CONTRACTS=true.
RUN_CLOUDINARY_CONTRACTS=false
CLOUDINARY_CONTRACT_CLOUD_NAME=""
CLOUDINARY_CONTRACT_API_KEY=""
CLOUDINARY_CONTRACT_API_SECRET=""
CLOUDINARY_CONTRACT_FIXTURE_DIR="./test/fixtures/cloudinary-contract"

# Mailer / SMTP (Default config connects to local Mailpit: SMTP 1025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HAMS System <noreply@hams.local>"
# Local Mailpit does not require TLS. Production must use SMTPS or require STARTTLS.
SMTP_REQUIRE_TLS=false

# Brevo SMTP for real-email testing (replace the Mailpit values above):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER="<SMTP login shown in Brevo Settings > SMTP & API>"
# SMTP_PASS="<Brevo SMTP key, not the Brevo API key>"
# SMTP_FROM="HAMS Test <verified-sender@example.com>"

# First two real ADMIN identities for production bootstrap (no password variables).
BOOTSTRAP_ADMIN_1_EMAIL=""
BOOTSTRAP_ADMIN_1_USERNAME=""
BOOTSTRAP_ADMIN_1_FIRSTNAME=""
BOOTSTRAP_ADMIN_1_LASTNAME=""
BOOTSTRAP_ADMIN_1_EMPLOYEE_ID=""
BOOTSTRAP_ADMIN_2_EMAIL=""
BOOTSTRAP_ADMIN_2_USERNAME=""
BOOTSTRAP_ADMIN_2_FIRSTNAME=""
BOOTSTRAP_ADMIN_2_LASTNAME=""
BOOTSTRAP_ADMIN_2_EMPLOYEE_ID=""

DATABASE_NAME="your_database_name"
DATABASE_USER="your_database_user"
DATABASE_PASSWORD="your_database_password"
